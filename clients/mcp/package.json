{
  "name": "@forked/mcp",
  "version": "0.1.0",
  "description": "MCP server that gives any agent undo: checkpoint, fork, rewind and replay its own state through forked, with an effectively-once side-effect log.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/clibequilibrium/forked",
    "directory": "clients/mcp"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "forked-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@forked/client": "file:../ts",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.6.0"
  }
}
