{
  "name": "@forked-run/client",
  "version": "0.2.0",
  "description": "TypeScript client for forked: versioned state for AI agents, fork, rewind and replay structured agent state.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/clibequilibrium/forked",
    "directory": "clients/ts"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
